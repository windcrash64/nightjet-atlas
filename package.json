{
  "name": "nightjet-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Student-friendly travel planning with real rail timetables, flight handoffs, an interactive map, and whole-trip budgeting.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test src/**/*.test.js",
    "data:airports": "node scripts/build-airports.mjs",
    "check": "npm test && npm run test:worker && npm run test:pipeline && npm run build",
    "dev:api": "wrangler dev --port 8787",
    "deploy": "npm run check && npm run build:cloudflare && node scripts/deploy-cloudflare.mjs deploy",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "verify:cloudflare": "node scripts/deploy-cloudflare.mjs verify",
    "rollback:cloudflare": "node scripts/deploy-cloudflare.mjs rollback",
    "data:edge": "node scripts/ingest-edge.mjs",
    "test:worker": "node --test worker/*.test.js",
    "test:pipeline": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "d3-geo": "^3.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.0",
    "wrangler": "^4.130.0"
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
